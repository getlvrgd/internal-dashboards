// Internal dashboards schema.
//
// One app, many dashboards. The CMO dashboard is no longer the product — it is the
// first row in `Dashboard`, and everything it owns (clients, tasks, KPIs, its SOP
// library, its people) hangs off that row. Adding the next internal dashboard is an
// INSERT, not a new codebase.
//
// Three things are worth knowing before reading further:
//
//   * Every workspace table carries `dashboardId` and is read through the guards in
//     src/lib/access.ts. Scoping is never left to the caller remembering a `where` —
//     see resolveDashboard(), which is the only way a page gets a dashboard id.
//
//   * A `Task` belongs to a week, identified by `weekOf` — always the Monday, at UTC
//     midnight. Nothing rolls over silently; see ensureWeek() in src/lib/week.ts for
//     the one place a new week's rows are created.
//
//   * A `Credential` never stores a password in the clear. `secretCipher` holds an
//     AES-256-GCM payload that only src/lib/secrets.ts can open, and only an owner or
//     a dashboard admin can reach the action that opens it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person with a login. One account spans every dashboard they have been given.
///
/// `role` is the platform role, not a per-dashboard one. OWNER and ADMIN reach every
/// dashboard without a Membership row; everyone else reaches exactly the dashboards
/// they hold a Membership for. That split is what lets the owner hub hand out access
/// from one roster instead of a Team page per dashboard.
model User {
  id String @id @default(cuid())

  email        String  @unique
  name         String
  passwordHash String
  /// OWNER | ADMIN | MEMBER | VIEWER — see src/lib/options.ts
  role         String
  /// Deactivating is how access is revoked; the row stays so past tasks keep their owner.
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())

  tasks       Task[]
  memberships Membership[]
}

/// One internal dashboard — the unit the owner hub manages.
///
/// A dashboard is a whole workspace: its own weekly board, client roster, KPI row, SOP
/// library and people. `isTemplate` marks the one new dashboards are cloned from, so
/// "create a dashboard" copies a shape that already works rather than opening an empty
/// one nobody knows how to fill.
model Dashboard {
  id   String @id @default(cuid())
  name String
  /// URL segment: /d/<slug>
  slug String @unique

  /// One line under the name on the owner hub, e.g. "Weekly marketing operations".
  description String?

  /// LIVE | DRAFT | ARCHIVED — see src/lib/options.ts. An archived dashboard closes to
  /// its members but stays reachable for the owner, who is the one retiring it.
  status String @default("DRAFT")

  /// One of the eight tile tints, so a dashboard is recognisable at a glance.
  color String @default("blue")

  /// New dashboards are cloned from this one. At most one row should carry it; the
  /// action in src/app/actions/dashboards.ts clears the flag elsewhere when it is set.
  isTemplate Boolean @default(false)

  /// Manual ordering on the owner hub; lower sorts first.
  position Int @default(0)

  /// The SOP library, as one block document rather than rows.
  ///
  /// Sections hold pages, pages hold blocks, and a block is a link, an embedded video,
  /// a written note or a checklist — the same model the sales rep hub uses, so the two
  /// products edit the same way. It is one JSON column because a library is always read
  /// and written whole: nothing queries "every SOP across dashboards by category", and
  /// modelling it as tables bought joins that no page ever needed.
  ///
  /// Shape and defaults live in src/lib/sops.ts.
  sopContent Json?

  /// Which panels the board shows, in what order, under what heading.
  ///
  /// The board is not a fixed page any more: progress, revenue, the to-do list, the
  /// week and the calls are panels you drag into the order you want and retitle. Order
  /// and headings are per dashboard, so an ops board can lead with calls while the CMO
  /// board leads with the week. Shape and defaults live in src/lib/board.ts.
  boardLayout Json?

  /// Daily revenue target, in cents. 0 means no goal has been set, and the revenue
  /// panel shows the day's total without a percentage.
  revenueGoalCents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients     Client[]
  tasks       Task[]
  kpis        Kpi[]
  memberships Membership[]
  payments    Payment[]
  calls       Call[]

  @@index([status])
}

/// One payment in. Logged by hand for now.
///
/// `clientId` is optional and nothing reads it yet — it is here so that when revenue
/// starts arriving per client, the rows already carry the attribution rather than
/// needing a backfill nobody can do accurately after the fact.
model Payment {
  id String @id @default(cuid())

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  /// Cents, as an integer. No float ever touches money — 0.1 + 0.2 is not 0.3, and a
  /// revenue figure that is a penny out is a revenue figure nobody trusts.
  amountCents Int

  note String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// When the money landed, which is not always when it was typed in.
  receivedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([dashboardId, receivedAt])
  @@index([clientId])
}

/// A standing call — the daily stand-up, the weekly review.
///
/// `time` is free text on purpose: "Every weekday at 9:00am" is what someone actually
/// wants to read, and modelling a recurrence rule would mean a scheduler, a timezone
/// per person and a UI for all of it, to render a sentence.
model Call {
  id String @id @default(cuid())

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  /// Set when the call belongs to one offer rather than the whole dashboard. The
  /// dashboard board shows the ones with no client; a client's board shows its own.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title String
  /// The join link. One click from the board into the call is the whole point.
  url   String?
  time  String?
  notes String?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dashboardId])
  @@index([clientId])
}

/// Who can open which dashboard, and what they may do inside it.
///
/// The per-dashboard `role` is deliberately separate from `User.role`: the same person
/// can run one dashboard and only read another. Owners and admins are not listed here —
/// they reach everything by platform role, and writing rows for them would mean every
/// new dashboard had to remember to grant them access.
model Membership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  /// MANAGER | MEMBER | VIEWER — see src/lib/options.ts
  role String @default("MEMBER")

  createdAt DateTime @default(now())

  @@unique([userId, dashboardId])
  @@index([dashboardId])
}

/// One client / offer owner, inside one dashboard.
model Client {
  id   String @id @default(cuid())
  name String
  /// URL segment: /d/<dashboard>/clients/<slug>. Unique per dashboard, not globally —
  /// two dashboards may each run a client called "acme" without colliding.
  slug String

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  /// The person on the client side who owns the offer.
  offerOwner String?
  niche      String?
  /// LIVE | ONBOARDING | PAUSED | CHURNED — see src/lib/options.ts
  status     String  @default("ONBOARDING")

  /// One of the eight tile tints, so a client is recognisable at a glance in a list.
  color String @default("blue")

  /// [{ label, url }] — Drive, Trello, ad account, anything else worth one click.
  links Json?

  notes String?

  /// Manual ordering in the client list; lower sorts first.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The offer's asset directory, as a block document.
  ///
  /// Same shape as the dashboard's SOP library and the sales rep hub's content: sections
  /// hold pages, pages hold blocks, and a block is a link, a video, a written note, a
  /// call or a checklist. Assets are per offer — the deck, the VSL, the ad account — so
  /// they live on the client rather than on the dashboard, while SOPs stay general.
  ///
  /// Shape and defaults live in src/lib/sops.ts.
  assetsContent Json?

  /// Panel order and headings for this client's board. See src/lib/board.ts.
  boardLayout Json?

  tasks       Task[]
  credentials Credential[]
  payments    Payment[]
  calls       Call[]

  @@unique([dashboardId, slug])
  @@index([dashboardId, status])
}

/// One line on the weekly board, or one quick capture on the to-do list.
model Task {
  id    String  @id @default(cuid())
  title String
  notes String?

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  /// 0 = Monday … 6 = Sunday. Null means it sits on the to-do list rather than a day.
  day Int?

  /// The Monday of the week this belongs to, at UTC midnight. Null for to-dos, which
  /// are not bound to a week and stay put until they are ticked off.
  weekOf DateTime?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  /// NOT_STARTED | IN_PROGRESS | DONE | BLOCKED — see src/lib/options.ts
  status   String @default("NOT_STARTED")
  /// LOW | NORMAL | HIGH
  priority String @default("NORMAL")

  dueDate DateTime?

  /// Marked as part of the standing weekly routine. ensureWeek() clones these forward
  /// into each new week; everything else is carried over only if it is unfinished.
  recurring Boolean @default(false)

  /// Set the moment status becomes DONE, so "finished this week" is answerable without
  /// keeping an event log.
  completedAt DateTime?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dashboardId, weekOf, day])
  @@index([clientId])
  @@index([dashboardId, status])
}

/// A login, always belonging to one client.
///
/// It used to be possible for a credential to be company-wide, with a null `clientId`
/// and a general vault page listing the lot. That is gone: logins differ per client, so
/// a shared folder was the wrong shape and the vault route it needed is one more place
/// access could be got wrong. A login now exists only inside the client it belongs to,
/// and dies with them.
///
/// The password is never stored or returned in the clear: `secretCipher` is sealed by
/// src/lib/secrets.ts and opened only by an explicit reveal action, which checks the
/// caller first. Listing credentials does not decrypt anything.
model Credential {
  id String @id @default(cuid())

  /// The tool or hosting service: Gmail, Kit, GoDaddy, Calendly…
  service String
  url     String?
  /// The email or username the account signs in with.
  identity String?

  /// AES-256-GCM, base64, as written by seal() in src/lib/secrets.ts.
  secretCipher String?

  notes String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

/// A number on the top row of a dashboard — MRR, ad spend, booked calls. Kept by
/// hand: this is a control surface, not an analytics pipeline, and a figure someone
/// typed after checking the source beats a stale automatic one.
model Kpi {
  id    String @id @default(cuid())
  label String
  /// Free text, so "12.4k", "3.2%" and "£8,400" all sit in the same row.
  value String @default("—")
  /// Shown under the figure, e.g. "vs 9.1k last month".
  sublabel String?
  /// One of the eight tile tints.
  color String @default("blue")

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  position Int @default(0)

  updatedAt DateTime @updatedAt

  @@index([dashboardId])
}
